*       text=auto
*.java  text
*.xml   text
*.jjt   text
*.jj    text
*.g4    text
*.md    text
*.sh    text eol=lf
*.bat   text eol=crlf
# we store mvnw.cmd with CRLF (without eol normalization) as dependabot creates updates
# and doesn't use git - so it would always change it back to crlf.
mvnw.cmd -text whitespace=cr-at-eol
*.png   -text
*.jpg   -text
*.svgz  -text
*.jar   -text
# always use LF for pom.xml to be able to reuse github action caching
# see .github/workflows/build.yml
pom.xml text eol=lf
